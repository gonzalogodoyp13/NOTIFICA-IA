generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  requestedSigningJobs                 SigningJob[]
  createdDeviceEnrollments             DeviceEnrollment[]
  id                                   String                            @id @default(cuid())
  authUserId                           String                            @unique
  email                                String                            @unique
  officeName                           String
  officeId                             Int
  isOfficeAdmin                        Boolean                           @default(false)
  isActive                             Boolean                           @default(true)
  createdAt                            DateTime                          @default(now())
  activityEvents                       ActivityEvent[]
  activityOutbox                       ActivityOutbox[]
  generatedReports                     GeneratedReport[]
  reportDeliveryRecipients             ReportDeliveryRecipient[]
  generatedReportVersions              GeneratedReportVersion[]          @relation("ReportVersionGenerator")
  requestedReportDeliveryAttempts      ReportDeliveryAttempt[]           @relation("ReportDeliveryRequester")
  reportDeliveryAttemptRecipients      ReportDeliveryAttemptRecipient[]
  requestedReportJobs                  ReportJob[]                       @relation("ReportJobRequester")
  reportRecipientConfiguration         ReportRecipientConfig?            @relation("ReportRecipientUser")
  createdReportRecipientConfigurations ReportRecipientConfig[]           @relation("ReportRecipientCreator")
  updatedReportRecipientConfigurations ReportRecipientConfig[]           @relation("ReportRecipientUpdater")
  createdReportSchedules               ReportSchedule[]                  @relation("ReportScheduleCreator")
  updatedReportSchedules               ReportSchedule[]                  @relation("ReportScheduleUpdater")
  createdCustomReportDefinitions       CustomReportDefinition[]          @relation("CustomReportDefinitionCreator")
  updatedCustomReportDefinitions       CustomReportDefinition[]          @relation("CustomReportDefinitionUpdater")
  customReportDefinitionRecipients     CustomReportDefinitionRecipient[]
  demandas                             Demanda[]
  receiptBulkOperations                ReceiptBulkOperation[]
  recibosDispatchBatches               RecibosDispatchBatch[]
  office                               Office                            @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId])
  @@map("users")
  @@unique([id, officeId])
}

model Office {
  signingDevices                SigningDevice[]
  signingArtifacts              SigningArtifact[]
  deviceEnrollments             DeviceEnrollment[]
  signingJobs                   SigningJob[]
  signingItems                  SigningItem[]
  signingAttempts               SigningAttempt[]
  documentSignatures            DocumentSignature[]
  documentDeliveries            DocumentDelivery[]
  id                            Int                            @id @default(autoincrement())
  nombre                        String
  cacheRevision                 Int                            @default(1)
  reportConfigRevision          Int                            @default(1)
  pdfReceptorNombre             String?
  pdfReceptorDireccionLinea     String?
  pdfReceptorTelefono           String?
  pdfFirmaStorageBucket         String?
  pdfFirmaStorageKey            String?
  pdfSelloStorageBucket         String?
  pdfSelloStorageKey            String?
  pdfReciboStampStorageBucket   String?
  pdfReciboStampStorageKey      String?
  createdAt                     DateTime                       @default(now())
  users                         User[]
  abogados                      Abogado[]
  bancos                        Banco[]
  procuradores                  Procurador[]
  abogadoBancos                 AbogadoBanco[]
  procuradorAbogados            ProcuradorAbogado[]
  procuradorBancos              ProcuradorBanco[]
  aranceles                     Arancel[]
  comunas                       Comuna[]
  materias                      Materia[]
  roles                         RolCausa[]
  tribunalesNuevos              Tribunal[]
  diligenciaTiposNuevos         DiligenciaTipo[]
  estampos                      Estampo[]                      @relation("OfficeEstampos")
  activityEvents                ActivityEvent[]
  activityOutbox                ActivityOutbox[]
  generatedReports              GeneratedReport[]
  reportDeliveryBatches         ReportDeliveryBatch[]
  reportDeliveryAttempts        ReportDeliveryAttempt[]
  reportJobs                    ReportJob[]
  reportRecipientConfigurations ReportRecipientConfig[]
  reportSchedules               ReportSchedule[]
  customReportDefinitions       CustomReportDefinition[]
  demandas                      Demanda[]
  estampoCustoms                EstampoCustom[]                @relation("OfficeEstampoCustoms")
  recibos                       Recibo[]
  receiptGenerationReservations ReceiptGenerationReservation[]
  documentNumberSequences       DocumentNumberSequence[]
  receiptBulkOperations         ReceiptBulkOperation[]
  emailTemplates                EmailTemplate[]
  recibosDispatchBatches        RecibosDispatchBatch[]
  recibosDispatchReplies        RecibosDispatchReply[]
  recibosReplySyncCheckpoints   RecibosReplySyncCheckpoint[]
  recibosProviderHealth         RecibosProviderHealth[]

  @@map("offices")
}

model ActivityEvent {
  id               Int               @id @default(autoincrement())
  officeId         Int
  userId           String?
  actorType        ActivityActorType @default(USER)
  source           ActivitySource    @default(WEB)
  eventType        String
  module           String
  result           String
  recordType       String?
  recordId         String?
  rolId            String?
  rol              String?
  shortName        String?
  description      String
  metadata         Json?
  requestId        String?
  eventVersion     Int               @default(1)
  deduplicationKey String?
  occurredAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  office           Office            @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([officeId, deduplicationKey])
  @@index([officeId, occurredAt])
  @@index([officeId, eventType, occurredAt])
  @@index([officeId, userId, occurredAt])
  @@index([requestId])
  @@index([module, occurredAt])
  @@index([result, occurredAt])
  @@map("activity_events")
}

model ActivityOutbox {
  id               String               @id @default(cuid())
  officeId         Int
  userId           String?
  actorType        ActivityActorType
  source           ActivitySource
  eventType        String
  payload          Json
  requestId        String?
  deduplicationKey String
  status           ActivityOutboxStatus @default(PENDING)
  attempts         Int                  @default(0)
  nextAttemptAt    DateTime             @default(now())
  lastError        String?
  processedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  office           Office               @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user             User?                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([officeId, deduplicationKey])
  @@index([status, nextAttemptAt])
  @@index([officeId, createdAt])
  @@map("activity_outbox")
}

enum ActivityActorType {
  USER
  SYSTEM
}

enum ActivitySource {
  WEB
  INTERNAL
  SYSTEM
}

enum ActivityOutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  DEAD
}

model GeneratedReport {
  id                 String                   @id @default(cuid())
  officeId           Int
  reportType         String
  identityKey        String
  customDefinitionId String?
  periodStart        DateTime
  periodEnd          DateTime
  periodDate         String
  timezone           String
  status             String
  storageBucket      String
  storageKey         String
  fileName           String
  mimeType           String
  sizeBytes          Int
  checksumSha256     String
  activityCount      Int
  generatedAt        DateTime
  expiresAt          DateTime?
  createdByUserId    String?
  generationMode     String
  metadata           Json?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  currentVersionId   String?                  @unique
  office             Office                   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy          User?                    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deliveryBatches    ReportDeliveryBatch[]
  versions           GeneratedReportVersion[] @relation("ReportVersions")
  currentVersion     GeneratedReportVersion?  @relation("CurrentReportVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deliveryAttempts   ReportDeliveryAttempt[]
  customDefinition   CustomReportDefinition?  @relation(fields: [customDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  jobs               ReportJob[]

  @@unique([officeId, identityKey, periodStart, periodEnd])
  @@index([officeId, reportType, periodDate])
  @@index([officeId, identityKey, periodDate])
  @@index([customDefinitionId])
  @@index([officeId, generatedAt])
  @@index([status])
  @@index([expiresAt])
  @@index([storageBucket, storageKey])
  @@map("generated_reports")
}

enum GeneratedReportVersionStatus {
  UPLOADING
  READY
  FAILED
  CORRUPT
  DELETE_PENDING
  DELETE_FAILED
  DELETED
}

model GeneratedReportVersion {
  id                String                       @id @default(cuid())
  reportId          String
  versionNumber     Int
  status            GeneratedReportVersionStatus @default(UPLOADING)
  storageBucket     String
  storageKey        String
  fileName          String
  mimeType          String
  sizeBytes         Int?
  checksumSha256    String?
  generatedByUserId String?
  generationMode    String
  generatedAt       DateTime
  metadata          Json?
  errorMessage      String?
  failedAt          DateTime?
  deleteRequestedAt DateTime?
  deletedAt         DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  report            GeneratedReport              @relation("ReportVersions", fields: [reportId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  currentForReport  GeneratedReport?             @relation("CurrentReportVersion")
  generatedBy       User?                        @relation("ReportVersionGenerator", fields: [generatedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deliveryAttempts  ReportDeliveryAttempt[]
  jobs              ReportJob[]

  @@unique([reportId, versionNumber])
  @@unique([storageBucket, storageKey])
  @@index([reportId, status, versionNumber])
  @@index([status, deleteRequestedAt])
  @@index([generatedByUserId])
  @@map("generated_report_versions")
}

enum ReportDeliveryAttemptMode {
  MANUAL
  SCHEDULED
}

enum ReportDeliveryTarget {
  ALL_AUTHORIZED
  FAILED_ONLY
}

enum ReportDeliveryAttemptStatus {
  PENDING
  SENDING
  SENT
  PARTIAL
  FAILED
  NO_RECIPIENTS
  CANCELLED
}

enum ReportRecipientAuthorization {
  AUTHORIZED
  REVOKED
}

enum ReportDeliveryRecipientStatus {
  PREPARED
  SENDING
  SENT
  FAILED
  SKIPPED
}

model ReportDeliveryAttempt {
  id                     String                           @id @default(cuid())
  officeId               Int
  reportId               String?
  reportVersionId        String?
  attemptNumber          Int
  mode                   ReportDeliveryAttemptMode
  target                 ReportDeliveryTarget
  parentAttemptId        String?
  idempotencyKey         String
  requestedByUserId      String?
  provider               String
  fromAccount            String
  intendedRecipientCount Int                              @default(0)
  sentCount              Int                              @default(0)
  failedCount            Int                              @default(0)
  skippedCount           Int                              @default(0)
  status                 ReportDeliveryAttemptStatus      @default(PENDING)
  errorMessage           String?
  startedAt              DateTime?
  completedAt            DateTime?
  legacyBatchId          String?                          @unique
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  office                 Office                           @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  report                 GeneratedReport?                 @relation(fields: [reportId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reportVersion          GeneratedReportVersion?          @relation(fields: [reportVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  requestedBy            User?                            @relation("ReportDeliveryRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  parentAttempt          ReportDeliveryAttempt?           @relation("ReportAttemptRetries", fields: [parentAttemptId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  retryAttempts          ReportDeliveryAttempt[]          @relation("ReportAttemptRetries")
  recipients             ReportDeliveryAttemptRecipient[]
  jobs                   ReportJob[]

  @@unique([reportId, attemptNumber])
  @@unique([officeId, idempotencyKey])
  @@index([officeId, createdAt])
  @@index([reportVersionId])
  @@index([parentAttemptId])
  @@index([requestedByUserId])
  @@index([status, createdAt])
  @@map("report_delivery_attempts")
}

enum ReportJobType {
  GENERATE
  DELIVER
}

enum ReportJobStatus {
  QUEUED
  RUNNING
  CANCEL_REQUESTED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReportJobOrigin {
  MANUAL
  SCHEDULED
  CHAINED
}

enum ReportJobRunOutcome {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  RETRY_SCHEDULED
}

enum ReportScheduleKind {
  DAILY
  MONTHLY
  CUSTOM
}

enum ReportScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum CustomReportDefinitionStatus {
  ACTIVE
  ARCHIVED
}

model ReportJob {
  id                   String                  @id @default(cuid())
  officeId             Int
  type                 ReportJobType
  status               ReportJobStatus         @default(QUEUED)
  origin               ReportJobOrigin
  reportKind           String
  customDefinitionId   String?
  scheduleId           String?
  retryOfJobId         String?
  requestedByUserId    String?
  idempotencyKey       String
  requestedPeriodStart DateTime
  requestedPeriodEnd   DateTime
  requestedPeriodLabel String
  payload              Json?
  progressPhase        String                  @default("queued")
  completedUnits       Int                     @default(0)
  totalUnits           Int                     @default(1)
  resultCode           String?
  safeError            String?
  reportId             String?
  reportVersionId      String?
  deliveryAttemptId    String?
  availableAt          DateTime                @default(now())
  scheduledFor         DateTime?
  attemptCount         Int                     @default(0)
  maxAttempts          Int                     @default(4)
  claimedAt            DateTime?
  leaseExpiresAt       DateTime?
  heartbeatAt          DateTime?
  cancelRequestedAt    DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  office               Office                  @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customDefinition     CustomReportDefinition? @relation(fields: [customDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  schedule             ReportSchedule?         @relation("ScheduleJobs", fields: [scheduleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  retryOfJob           ReportJob?              @relation("ReportJobRetries", fields: [retryOfJobId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  retryJobs            ReportJob[]             @relation("ReportJobRetries")
  requestedBy          User?                   @relation("ReportJobRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  report               GeneratedReport?        @relation(fields: [reportId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reportVersion        GeneratedReportVersion? @relation(fields: [reportVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deliveryAttempt      ReportDeliveryAttempt?  @relation(fields: [deliveryAttemptId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  runs                 ReportJobRun[]
  lastForSchedules     ReportSchedule[]        @relation("ScheduleLastJob")

  @@unique([officeId, idempotencyKey])
  @@index([status, availableAt, createdAt])
  @@index([officeId, createdAt])
  @@index([officeId, status, createdAt])
  @@index([scheduleId, scheduledFor])
  @@index([retryOfJobId])
  @@index([customDefinitionId])
  @@map("report_jobs")
}

model ReportJobRun {
  id            String              @id @default(cuid())
  jobId         String
  attemptNumber Int
  outcome       ReportJobRunOutcome @default(RUNNING)
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  resultCode    String?
  safeError     String?
  createdAt     DateTime            @default(now())
  job           ReportJob           @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([jobId, attemptNumber])
  @@index([jobId, startedAt])
  @@map("report_job_runs")
}

model ReportRecipientConfig {
  id              String   @id @default(cuid())
  officeId        Int
  userId          String   @unique
  dailyEnabled    Boolean  @default(true)
  monthlyEnabled  Boolean  @default(true)
  customEnabled   Boolean  @default(false)
  isEnabled       Boolean  @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  office          Office   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user            User     @relation("ReportRecipientUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy       User?    @relation("ReportRecipientCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedBy       User?    @relation("ReportRecipientUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([officeId, userId])
  @@index([officeId, isEnabled])
  @@map("report_recipient_configs")
}

model ReportSchedule {
  id                       String                  @id @default(cuid())
  officeId                 Int
  kind                     ReportScheduleKind
  identityKey              String
  customDefinitionId       String?                 @unique
  frequency                ReportScheduleFrequency
  localTime                String                  @default("07:00")
  weekday                  Int?
  monthDay                 Int?
  timezone                 String                  @default("America/Santiago")
  enabled                  Boolean                 @default(false)
  latenessThresholdMinutes Int                     @default(60)
  nextRunAt                DateTime?
  lastAttemptAt            DateTime?
  lastSuccessAt            DateTime?
  lastFailureAt            DateTime?
  lastJobId                String?
  consecutiveFailures      Int                     @default(0)
  safeLastError            String?
  createdByUserId          String?
  updatedByUserId          String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  office                   Office                  @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customDefinition         CustomReportDefinition? @relation(fields: [customDefinitionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lastJob                  ReportJob?              @relation("ScheduleLastJob", fields: [lastJobId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  jobs                     ReportJob[]             @relation("ScheduleJobs")
  createdBy                User?                   @relation("ReportScheduleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedBy                User?                   @relation("ReportScheduleUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([officeId, identityKey])
  @@index([enabled, nextRunAt])
  @@index([officeId, enabled])
  @@map("report_schedules")
}

model CustomReportDefinition {
  id               String                            @id @default(cuid())
  officeId         Int
  name             String
  description      String?
  status           CustomReportDefinitionStatus      @default(ACTIVE)
  modules          Json
  actionCategories Json
  results          Json
  actorUserIds     Json
  includeSystem    Boolean                           @default(true)
  selectedColumns  Json
  createdByUserId  String?
  updatedByUserId  String?
  archivedAt       DateTime?
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt
  office           Office                            @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy        User?                             @relation("CustomReportDefinitionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedBy        User?                             @relation("CustomReportDefinitionUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  recipients       CustomReportDefinitionRecipient[]
  schedule         ReportSchedule?
  reports          GeneratedReport[]
  jobs             ReportJob[]

  @@unique([officeId, name])
  @@index([officeId, status, updatedAt])
  @@map("custom_report_definitions")
}

model CustomReportDefinitionRecipient {
  id           String                 @id @default(cuid())
  definitionId String
  userId       String
  createdAt    DateTime               @default(now())
  definition   CustomReportDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([definitionId, userId])
  @@index([userId])
  @@map("custom_report_definition_recipients")
}

model ReportDeliveryAttemptRecipient {
  id                        String                        @id @default(cuid())
  attemptId                 String
  userId                    String
  email                     String
  authorizationDecision     ReportRecipientAuthorization
  status                    ReportDeliveryRecipientStatus @default(PREPARED)
  attemptCount              Int                           @default(0)
  providerMessageId         String?
  providerThreadId          String?
  providerInternetMessageId String?
  attachmentFilename        String?
  attachmentMimeType        String?
  attachmentByteSize        Int?
  attachmentSha256          String?
  errorMessage              String?
  sentAt                    DateTime?
  completedAt               DateTime?
  legacyRecipientId         String?                       @unique
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  attempt                   ReportDeliveryAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user                      User                          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([attemptId, userId])
  @@index([attemptId, status])
  @@index([userId])
  @@index([email])
  @@map("report_delivery_attempt_recipients")
}

model ReportDeliveryBatch {
  id                     String                    @id @default(cuid())
  officeId               Int
  reportId               String?
  reportType             String
  periodStart            DateTime
  periodEnd              DateTime
  periodDate             String
  timezone               String
  status                 String
  provider               String
  fromAccount            String
  intendedRecipientCount Int                       @default(0)
  sentCount              Int                       @default(0)
  failedCount            Int                       @default(0)
  skippedCount           Int                       @default(0)
  errorMessage           String?
  mode                   String
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  office                 Office                    @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  report                 GeneratedReport?          @relation(fields: [reportId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  recipients             ReportDeliveryRecipient[]

  @@unique([officeId, reportType, periodStart, periodEnd])
  @@index([officeId, reportType, periodDate])
  @@index([reportId])
  @@index([status])
  @@index([createdAt])
  @@map("report_delivery_batches")
}

model ReportDeliveryRecipient {
  id                        String              @id @default(cuid())
  batchId                   String
  userId                    String
  email                     String
  status                    String
  attemptCount              Int                 @default(0)
  providerMessageId         String?
  providerThreadId          String?
  providerInternetMessageId String?
  attachmentFilename        String?
  attachmentMimeType        String?
  attachmentByteSize        Int?
  attachmentSha256          String?
  errorMessage              String?
  sentAt                    DateTime?
  completedAt               DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  batch                     ReportDeliveryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user                      User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([batchId, userId])
  @@index([batchId])
  @@index([userId])
  @@index([status])
  @@index([email])
  @@map("report_delivery_recipients")
}

model Abogado {
  id           Int                 @id @default(autoincrement())
  officeId     Int
  nombre       String?
  rut          String?
  direccion    String?
  comuna       String?
  telefono     String?
  email        String?
  createdAt    DateTime            @default(now())
  bancos       AbogadoBanco[]      @relation("AbogadoBancos")
  aranceles    Arancel[]           @relation("AbogadoAranceles")
  demandas     Demanda[]
  procuradores ProcuradorAbogado[] @relation("AbogadoProcuradores")
  office       Office              @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId])
  @@map("abogados")
}

model Banco {
  id             Int            @id @default(autoincrement())
  officeId       Int
  nombre         String
  procuradores   ProcuradorBanco[]
  demandas       Demanda[]
  cuenta         String?
  createdAt      DateTime       @default(now())
  abogadoBancos  AbogadoBanco[] @relation("BancoAbogados")
  aranceles      Arancel[]      @relation("BancoAranceles")
  notificaciones Notificacion[] @relation("NotificacionBanco")
  recibos        Recibo[]       @relation("ReciboBanco")
  office         Office         @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId])
  @@map("bancos")
}

model Procurador {
  id        Int                 @id @default(autoincrement())
  officeId  Int
  nombre    String
  bancos    ProcuradorBanco[]
  email     String?
  telefono  String?
  notas     String?
  activo    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  abogados  ProcuradorAbogado[] @relation("ProcuradorAbogados")
  demandas  Demanda[]
  office    Office              @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId])
  @@index([officeId, activo])
  @@map("procuradores")
}

model ProcuradorBanco {
  id           Int        @id @default(autoincrement())
  officeId     Int
  procuradorId Int
  bancoId      Int
  procurador   Procurador @relation(fields: [procuradorId], references: [id], onDelete: Cascade)
  banco        Banco      @relation(fields: [bancoId], references: [id], onDelete: Cascade)
