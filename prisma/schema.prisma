}

enum SignatureLevel {
  PADES_B
  PADES_T
  PADES_LT
  PADES_LTA
}

enum SigningAttemptResult {
  RUNNING
  SUCCEEDED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
  OPERATOR_REQUIRED
  LEASE_EXPIRED
  RELEASED
  CANCELLED
}

enum DocumentDeliveryStatus {
  PENDING
  DOWNLOADING
  DELIVERED
  RETRY_PENDING
  FAILED
  CANCELLED
}

model SigningDevice {
  id                    String @id @default(cuid())
  officeId              Int
  name                  String
  role                  SigningDeviceRole
  health                SigningDeviceHealth @default(OFFLINE)
  publicKey             String? @unique
  certificateThumbprint String?
  certificateIssuer     String?
  certificateSubject    String?
  certificateExpiresAt  DateTime?
  providerType          String?
  agentVersion          String?
  lastHeartbeatAt       DateTime?
  diskFreeBytes         BigInt?
  healthErrorCode       String?
  lastSuccessfulContactAt DateTime?
  revokedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  office                Office @relation(fields: [officeId], references: [id], onDelete: Restrict)
  enrollments           DeviceEnrollment[]
  claimedItems          SigningItem[]
  attempts              SigningAttempt[]
  signatures            DocumentSignature[]
  deliveries            DocumentDelivery[]
  challenges            DeviceChallenge[]
  sessions              DeviceSession[]
  artifacts             SigningArtifact[]

  @@unique([id, officeId])
  @@index([officeId, health, createdAt])
  @@map("signing_devices")
}

model DeviceEnrollment {
  id              String @id @default(cuid())
  officeId        Int
  role            SigningDeviceRole
  secretHash      String @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  revokedAt       DateTime?
  deviceId        String?
  createdByUserId String
  createdAt       DateTime @default(now())
  office          Office @relation(fields: [officeId], references: [id], onDelete: Restrict)
  device          SigningDevice? @relation(fields: [deviceId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User @relation(fields: [createdByUserId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, officeId])
  @@index([officeId, expiresAt])
  @@index([deviceId, officeId])
  @@index([createdByUserId, officeId])
  @@map("device_enrollments")
}

model DeviceChallenge {
  id         String @id @default(uuid())
  officeId   Int
  deviceId   String
  nonceHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  device     SigningDevice @relation(fields: [deviceId, officeId], references: [id, officeId], onDelete: Cascade, map: "device_challenges_device_fkey")

  @@index([expiresAt], map: "device_challenges_expires_idx")
  @@index([deviceId, officeId], map: "device_challenges_device_idx")
  @@map("device_challenges")
}

model DeviceSession {
  id         String @id @default(uuid())
  officeId   Int
  deviceId   String
  tokenHash  String @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  device     SigningDevice @relation(fields: [deviceId, officeId], references: [id, officeId], onDelete: Cascade, map: "device_sessions_device_fkey")

  @@index([expiresAt], map: "device_sessions_expires_idx")
  @@index([deviceId, officeId], map: "device_sessions_device_idx")
  @@map("device_sessions")
}

model DeviceRateLimit {
  key       String @id
  windowAt  DateTime
  count     Int
  @@index([windowAt], map: "device_rate_limits_window_idx")
  @@map("device_rate_limits")
}

model SigningJob {
  id                 String @id @default(cuid())
  officeId           Int
  requestedByUserId  String
  idempotencyKey      String
  requestHash        String
  signerFingerprint  String
  requestedLevel     SignatureLevel @default(PADES_LT)
  status             SigningJobStatus @default(QUEUED)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  completedAt        DateTime?
  office             Office @relation(fields: [officeId], references: [id], onDelete: Restrict)
  requestedBy        User @relation(fields: [requestedByUserId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)
  items              SigningItem[]

  @@unique([id, officeId, signerFingerprint])
  @@unique([officeId, idempotencyKey])
  @@index([officeId, status, createdAt])
  @@index([requestedByUserId, officeId])
  @@map("signing_jobs")
}

model SigningItem {
  id                 String @id @default(cuid())
  officeId           Int
  jobId              String
  documentoId        String
  sourceVersionId    String
  sourceChecksum     String
  signerFingerprint  String
  status             SigningItemStatus @default(QUEUED)
  leaseOwner         String?
  // A fresh random fence for every claim, including reclaims by the same device.
  leaseToken         String?
  leaseExpiresAt     DateTime?
  attemptCount       Int @default(0)
  maxAttempts        Int @default(4)
  availableAt        DateTime @default(now())
  errorCode          String?
  safeError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  completedAt        DateTime?
  office             Office @relation(fields: [officeId], references: [id], onDelete: Restrict)
  job                SigningJob @relation(fields: [jobId, officeId, signerFingerprint], references: [id, officeId, signerFingerprint], onDelete: Restrict, onUpdate: Restrict)
  sourceVersion      DocumentoVersion @relation(fields: [sourceVersionId, officeId, documentoId], references: [id, officeId, documentoId], onDelete: Restrict, onUpdate: Restrict)
  device             SigningDevice? @relation(fields: [leaseOwner, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)
  attempts           SigningAttempt[]
  signature          DocumentSignature?
  artifacts          SigningArtifact[]

  @@unique([id, officeId])
  @@unique([id, officeId, sourceVersionId, documentoId, signerFingerprint], map: "signing_items_signature_identity_key")
  @@unique([jobId, sourceVersionId])
  @@index([officeId, status, availableAt, createdAt])
  @@index([leaseOwner, leaseExpiresAt])
  @@index([sourceVersionId, officeId, documentoId])
  @@map("signing_items")
}

// Durable reservation before upload; COMMITTED rows retain validator evidence.
model SigningArtifact {
  id             String @id
  officeId       Int
  itemId         String
  deviceId       String
  leaseToken     String
  storageBucket  String
  storageKey     String @unique
  checksumSha256 String
  sizeBytes      Int
  state          String @default("PENDING")
  validation     Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  office         Office @relation(fields: [officeId], references: [id], onDelete: Restrict)
  item           SigningItem @relation(fields: [itemId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)
  device         SigningDevice @relation(fields: [deviceId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)

  @@index([officeId, state, expiresAt])
  @@index([itemId, officeId])
  @@index([deviceId, officeId])
  @@map("signing_artifacts")
}

model SigningAttempt {
  id              String @id @default(cuid())
  officeId        Int
  itemId          String
  deviceId        String
  attemptNumber   Int
  leaseToken      String @unique
  result          SigningAttemptResult @default(RUNNING)
  errorCode       String?
  safeError       String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  office          Office @relation(fields: [officeId], references: [id], onDelete: Restrict)
  item            SigningItem @relation(fields: [itemId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)
  device          SigningDevice @relation(fields: [deviceId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([itemId, attemptNumber])
  @@index([officeId, result, startedAt])
  @@index([deviceId, officeId])
  @@map("signing_attempts")
}

model DocumentSignature {
  id                  String @id @default(cuid())
  officeId            Int
  itemId              String @unique
  deviceId            String
  documentoId         String
  sourceVersionId     String
  signedVersionId     String
  signerFingerprint   String
  certificateIssuer   String
  providerType        String
  level               SignatureLevel
  digestAlgorithm     String @default("SHA256")
  sourceChecksum      String
  signedChecksum      String
  timestampAt         DateTime?
  revocationCheckedAt DateTime
  validatedAt         DateTime
  createdAt           DateTime @default(now())
  office              Office @relation(fields: [officeId], references: [id], onDelete: Restrict)
  item                SigningItem @relation(fields: [itemId, officeId, sourceVersionId, documentoId, signerFingerprint], references: [id, officeId, sourceVersionId, documentoId, signerFingerprint], onDelete: Restrict, onUpdate: Restrict, map: "document_signatures_item_identity_fkey")
  device              SigningDevice @relation(fields: [deviceId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)
  sourceVersion       DocumentoVersion @relation("SignatureSource", fields: [sourceVersionId, officeId, documentoId], references: [id, officeId, documentoId], onDelete: Restrict, onUpdate: Restrict)
  signedVersion       DocumentoVersion @relation("SignatureOutput", fields: [signedVersionId, officeId, documentoId], references: [id, officeId, documentoId], onDelete: Restrict, onUpdate: Restrict)
  deliveries          DocumentDelivery[]

  @@unique([id, officeId])
  @@unique([officeId, sourceVersionId, signerFingerprint], map: "document_signatures_source_signer_key")
  @@unique([signedVersionId])
  @@unique([itemId, officeId, sourceVersionId, documentoId, signerFingerprint], map: "document_signatures_item_identity_key")
  @@index([officeId, documentoId, createdAt])
  @@index([deviceId, officeId])
  @@map("document_signatures")
}

model DocumentDelivery {
  id              String @id @default(cuid())
  officeId        Int
  signatureId     String
  deviceId        String
  status          DocumentDeliveryStatus @default(PENDING)
  attemptCount    Int @default(0)
  availableAt     DateTime @default(now())
  deliveredAt     DateTime?
  errorCode       String?
  safeError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  office          Office @relation(fields: [officeId], references: [id], onDelete: Restrict)
  signature       DocumentSignature @relation(fields: [signatureId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)
  device          SigningDevice @relation(fields: [deviceId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([signatureId, deviceId])
  @@index([officeId, status, createdAt])
  @@index([deviceId, status, availableAt, id])
  @@map("document_deliveries")
}
