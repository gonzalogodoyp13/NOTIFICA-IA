generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  officeName String
  officeId   Int
  isOfficeAdmin Boolean  @default(false)
  createdAt  DateTime   @default(now())
  auditLogs  AuditLog[]
  activityEvents ActivityEvent[]
  generatedReports GeneratedReport[]
  demandas   Demanda[]
  receiptBulkOperations ReceiptBulkOperation[]
  recibosDispatchBatches RecibosDispatchBatch[]
  office     Office     @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId])
  @@map("users")
}

model Office {
  id             Int             @id @default(autoincrement())
  nombre         String
  pdfReceptorNombre String?
  pdfReceptorDireccionLinea String?
  pdfReceptorTelefono String?
  pdfFirmaStorageBucket String?
  pdfFirmaStorageKey String?
  pdfSelloStorageBucket String?
  pdfSelloStorageKey String?
  pdfReciboStampStorageBucket String?
  pdfReciboStampStorageKey String?
  createdAt      DateTime        @default(now())
  users          User[]
  abogados       Abogado[]
  bancos         Banco[]
  procuradores   Procurador[]
  abogadoBancos  AbogadoBanco[]
  procuradorAbogados ProcuradorAbogado[]
  aranceles      Arancel[]
  comunas        Comuna[]
  materias       Materia[]
  roles          RolCausa[]
  tribunalesNuevos Tribunal[]
  diligenciaTiposNuevos DiligenciaTipo[]
  estampos       Estampo[]       @relation("OfficeEstampos")
  auditLogs      AuditLog[]
  activityEvents ActivityEvent[]
  generatedReports GeneratedReport[]
  demandas       Demanda[]
  estampoCustoms EstampoCustom[] @relation("OfficeEstampoCustoms")
  recibos        Recibo[]
  documentNumberSequences DocumentNumberSequence[]
  receiptBulkOperations ReceiptBulkOperation[]
  emailTemplates EmailTemplate[]
  recibosDispatchBatches RecibosDispatchBatch[]
  recibosDispatchReplies RecibosDispatchReply[]
  recibosReplySyncCheckpoints RecibosReplySyncCheckpoint[]
  recibosProviderHealth RecibosProviderHealth[]

  @@map("offices")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String
  officeId  Int
  tabla     String
  accion    String
  diff      Json?
  createdAt DateTime @default(now())
  office    Office   @relation(fields: [officeId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ActivityEvent {
  id          Int      @id @default(autoincrement())
  officeId    Int
  userId      String
  eventType   String
  module      String
  result      String
  recordType  String?
  recordId    String?
  rolId       String?
  rol         String?
  shortName   String?
  description String
  metadata    Json?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  office      Office   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId, occurredAt])
  @@index([userId, occurredAt])
  @@index([eventType])
  @@index([module])
  @@index([result])
  @@map("activity_events")
}

model GeneratedReport {
  id              String   @id @default(cuid())
  officeId        Int
  reportType      String
  periodStart     DateTime
  periodEnd       DateTime
  periodDate      String
  timezone        String
  status          String
  storageBucket   String
  storageKey      String
  fileName        String
  mimeType        String
  sizeBytes       Int
  checksumSha256  String
  activityCount   Int
  generatedAt     DateTime
  expiresAt       DateTime?
  createdByUserId String?
  generationMode  String
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  office          Office   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([officeId, reportType, periodStart, periodEnd])
  @@index([officeId, reportType, periodDate])
  @@index([officeId, generatedAt])
  @@index([status])
  @@index([expiresAt])
  @@index([storageBucket, storageKey])
  @@map("generated_reports")
}

model Abogado {
  id           Int            @id @default(autoincrement())
  officeId     Int
  nombre       String?
  rut          String?
  direccion    String?
  comuna       String?
  telefono     String?
  email        String?
  createdAt    DateTime       @default(now())
  bancos       AbogadoBanco[] @relation("AbogadoBancos")
  aranceles    Arancel[]      @relation("AbogadoAranceles")
  demandas     Demanda[]
  procuradores ProcuradorAbogado[] @relation("AbogadoProcuradores")
  office       Office         @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId])
  @@map("abogados")
}

model Banco {
  id                Int               @id @default(autoincrement())
  officeId          Int
  nombre            String
  cuenta            String?
  createdAt         DateTime          @default(now())
  abogadoBancos     AbogadoBanco[]    @relation("BancoAbogados")
  aranceles         Arancel[]         @relation("BancoAranceles")
  office            Office            @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId])
  @@map("bancos")
}

model Procurador {
  id        Int                 @id @default(autoincrement())
  officeId  Int
  nombre    String
  email     String?
  telefono  String?
  notas     String?
  activo    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  abogados  ProcuradorAbogado[] @relation("ProcuradorAbogados")
  demandas  Demanda[]
  office    Office              @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId])
  @@index([officeId, activo])
  @@map("procuradores")
}

model AbogadoBanco {
  id        Int      @id @default(autoincrement())
  officeId  Int
  abogadoId Int
  bancoId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  abogado   Abogado  @relation("AbogadoBancos", fields: [abogadoId], references: [id], onDelete: Cascade)
  banco     Banco    @relation("BancoAbogados", fields: [bancoId], references: [id], onDelete: Cascade)
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([officeId, abogadoId, bancoId])
  @@index([abogadoId])
  @@index([bancoId])
  @@index([officeId])
  @@map("abogado_bancos")
}

model ProcuradorAbogado {
  id           Int        @id @default(autoincrement())
  officeId     Int
  procuradorId Int
  abogadoId    Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  procurador   Procurador @relation("ProcuradorAbogados", fields: [procuradorId], references: [id], onDelete: Cascade)
  abogado      Abogado    @relation("AbogadoProcuradores", fields: [abogadoId], references: [id], onDelete: Cascade)
  office       Office     @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([officeId, procuradorId, abogadoId])
  @@index([procuradorId])
  @@index([abogadoId])
  @@index([officeId])
  @@map("procurador_abogados")
}

model Arancel {
  id                   Int      @id @default(autoincrement())
  officeId             Int
  bancoId              Int
  abogadoId            Int?
  estampoId            String?
  estampoBaseCategoria String?
  monto                Int
  activo               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  abogado              Abogado? @relation("AbogadoAranceles", fields: [abogadoId], references: [id], onDelete: Cascade)
  banco                Banco    @relation("BancoAranceles", fields: [bancoId], references: [id], onDelete: Cascade)
  estampo              Estampo? @relation("EstampoAranceles", fields: [estampoId], references: [id], onDelete: Cascade)
  office               Office   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([officeId, bancoId, abogadoId, estampoId], name: "aranceles_legacy_unique")
  @@unique([officeId, bancoId, abogadoId, estampoBaseCategoria], name: "aranceles_wizard_unique")
  @@index([officeId, bancoId, estampoId])
  @@index([officeId, abogadoId, estampoId])
  @@index([officeId, bancoId])
  @@index([estampoId])
  @@index([officeId, bancoId, estampoBaseCategoria])
  @@map("aranceles")
}

model Comuna {
  id         Int         @id @default(autoincrement())
  officeId   Int
  nombre     String
  region     String?
  createdAt  DateTime    @default(now())
  ejecutados Ejecutado[]
  office     Office      @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId])
  @@map("comunas")
}

model Materia {
  id        Int       @id @default(autoincrement())
  officeId  Int
  nombre    String
  createdAt DateTime  @default(now())
  demandas  Demanda[]
  office    Office    @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId])
  @@map("materias")
}

model Demanda {
  id         String      @id @default(cuid())
  rol        String
  caratula   String
  cuantia    Float
  abogadoId  Int
  officeId   Int
  userId     String
  createdAt  DateTime    @default(now())
  materiaId  Int?
  procuradorId Int?
  roles      RolCausa?
  abogados   Abogado     @relation(fields: [abogadoId], references: [id])
  materia    Materia?    @relation(fields: [materiaId], references: [id])
  procurador Procurador? @relation(fields: [procuradorId], references: [id], onDelete: SetNull)
  offices    Office      @relation(fields: [officeId], references: [id])
  users      User        @relation(fields: [userId], references: [id])
  ejecutados Ejecutado[]

  @@unique([officeId, rol])
  @@map("demandas")
}

model Ejecutado {
  id             String         @id @default(cuid())
  demandaId      String
  nombre         String
  rut            String
  direccion      String?
  comunaId       Int?
  rvm            Json?
  comunas        Comuna?        @relation(fields: [comunaId], references: [id])
  demandas       Demanda        @relation(fields: [demandaId], references: [id])
  notificaciones Notificacion[]

  @@map("ejecutados")
}

model RolCausa {
  id          String       @id
  demandaId   String?      @unique
  officeId    Int
  rol         String
  tribunalId  String
  estado      EstadoRol    @default(pendiente)
  createdAt   DateTime     @default(now())
  diligencias Diligencia[]
  documentos  Documento[]
  notas       Nota[]
  recibos     Recibo[]
  demanda     Demanda?     @relation(fields: [demandaId], references: [id])
  tribunal    Tribunal     @relation(fields: [tribunalId], references: [id])
  office      Office       @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId, createdAt])
  @@index([rol])
}

model Diligencia {
  id             String           @id @default(cuid())
  rolId          String
  tipoId         String
  estado         EstadoDiligencia @default(pendiente)
  fecha          DateTime
  meta           Json?
  estadoCobro    EstadoCobro      @default(NO_PAGADO)
  fechaPago      DateTime?
  createdAt      DateTime         @default(now())
  rol            RolCausa         @relation(fields: [rolId], references: [id])
  tipo           DiligenciaTipo   @relation(fields: [tipoId], references: [id])
  documentos     Documento[]
  notificaciones Notificacion[]

  @@index([rolId, createdAt])
  @@index([fechaPago])
}

model Notificacion {
  id             String      @id
  diligenciaId   String
  meta           Json?
  createdAt      DateTime?
  updatedAt      DateTime?
  voidedAt       DateTime?
  voidReason     String?
  voidedByUserId String?
  ejecutadoId    String?
  diligencia     Diligencia  @relation(fields: [diligenciaId], references: [id])
  ejecutado      Ejecutado?  @relation(fields: [ejecutadoId], references: [id], onDelete: Restrict)
  documentos     Documento[]

  @@index([ejecutadoId])
  @@map("notificaciones")
}

model Documento {
  id             String        @id @default(cuid())
  rolId          String
  diligenciaId   String?
  notificacionId String?
  estampoId      String?
  currentVersionId String?
  nombre         String
  tipo           String
  pdfId          String?
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  textoEditado   String?
  estampoBaseId  Int?
  voidedAt       DateTime?
  voidReason     String?
  voidedByUserId String?
  generatedByUserId String?
  generatedAt    DateTime?
  sourceTemplate Json?
  generationVariables Json?
  generationVersion Int @default(1)
  diligencia     Diligencia?   @relation(fields: [diligenciaId], references: [id])
  notificacion   Notificacion? @relation(fields: [notificacionId], references: [id])
  estampoBase    EstampoBase?  @relation(fields: [estampoBaseId], references: [id])
  estampo        Estampo?      @relation(fields: [estampoId], references: [id])
  rol            RolCausa      @relation(fields: [rolId], references: [id])
  versions       DocumentoVersion[] @relation("DocumentoVersions")
  currentVersion DocumentoVersion? @relation("DocumentoCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([rolId, createdAt])
  @@index([currentVersionId])
}

model DocumentoVersion {
  id               String      @id @default(cuid())
  documentoId      String
  versionNumber    Int
  storageBucket    String
  storageKey       String
  fileName         String
  sizeBytes        Int
  checksumSha256   String
  mimeType         String
  createdAt        DateTime    @default(now())
  createdByUserId  String?
  deletedAt        DateTime?
  deletedByUserId  String?
  documento        Documento   @relation("DocumentoVersions", fields: [documentoId], references: [id], onDelete: Cascade)
  currentForDocuments Documento[] @relation("DocumentoCurrentVersion")
  recibos          Recibo[]

  @@unique([documentoId, versionNumber])
  @@index([documentoId, createdAt])
  @@index([storageBucket, storageKey])
}

model Nota {
  id        String   @id @default(cuid())
  rolId     String
  userId    String
  contenido String
  createdAt DateTime @default(now())
  rol       RolCausa @relation(fields: [rolId], references: [id])

  @@index([rolId, createdAt])
}

model Recibo {
  id             String   @id @default(cuid())
  rolId          String
  officeId       Int?
  diligenciaId   String?
  notificacionId String?
  documentoId    String?
  documentVersionId String?
  numeroRecibo   String?
  numeroReciboYear Int?
  numeroBoleta   String?
  monto          Float
  medio          String
  ref            String?
  fechaEjecucion DateTime?
  fechaRecibo    DateTime?
  createdAt      DateTime @default(now())
  rol            RolCausa @relation(fields: [rolId], references: [id])
  office         Office?  @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documentVersion DocumentoVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)

  @@index([officeId, numeroReciboYear])
  @@index([rolId, fechaRecibo])
  @@index([fechaRecibo])
  @@index([rolId, createdAt])
  @@index([createdAt])
  @@index([diligenciaId])
  @@index([notificacionId])
  @@index([documentoId])
  @@index([documentVersionId])
}

model ReceiptBulkOperation {
  id            String   @id @default(cuid())
  officeId      Int
  userId        String
  action        String
  receiptIds    Json
  beforeState   Json
  afterState    Json
  summary       Json?
  createdAt     DateTime @default(now())
  undoneAt      DateTime?
  undoneByUserId String?
  office        Office   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([officeId, createdAt])
  @@index([userId, createdAt])
}

model DocumentNumberSequence {
  id           String       @id @default(cuid())
  officeId     Int
  year         Int
  documentType DocumentType
  nextNumber   Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  office       Office       @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([officeId, year, documentType])
  @@index([officeId, year])
}

model EmailTemplate {
  id              String   @id @default(cuid())
  officeId        Int
  key             String
  subject         String
  body            String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  office          Office   @relation(fields: [officeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([officeId, key])
  @@index([officeId])
  @@map("email_templates")
}

model RecibosDispatchBatch {
  id                 String   @id @default(cuid())
  officeId           Int
  userId             String
  recipientMode      String
  provider           String
  fromAccount        String?
  status             String
  selectedCount      Int      @default(0)
  excludedCount      Int      @default(0)
  groupCount         Int      @default(0)
  sentCount          Int      @default(0)
  failedCount        Int      @default(0)
  skippedCount       Int      @default(0)
  templateMode       String
  dispatchKind       String   @default("standard")
  errorMessage       String?
  replyCount         Int      @default(0)
  lastReplyAt        DateTime?
  hasReplies         Boolean  @default(false)
  createdAt          DateTime @default(now())
  sentAt             DateTime?
  completedAt        DateTime?
  office             Office   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipients         RecibosDispatchRecipient[]

  @@index([officeId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@map("recibos_dispatch_batches")
}

model RecibosDispatchRecipient {
  id                    String   @id @default(cuid())
  batchId               String
  groupKey              String
  recipientType         String
  recipientName         String
  recipientEmails       Json
  subject               String
  body                  String
  status                String
  attemptCount          Int      @default(0)
  trackingToken         String?  @unique
  providerMessageId     String?
  providerThreadId      String?
  providerInternetMessageId String?
  resolvedAt            DateTime?
  resolvedByUserId      String?
  resolutionNote        String?
  duplicateOverrideReason String?
  duplicateConfirmedByUserId String?
  duplicateConfirmedAt  DateTime?
  overlappingDispatchIds Json?
  resendOfRecipientId   String?
  resendReason          String?
  partialResendConfirmed Boolean @default(false)
  attachmentFilename    String?
  attachmentMimeType    String?
  attachmentByteSize    Int?
  attachmentSha256      String?
  reciboCount           Int      @default(0)
  totalAmount           Float    @default(0)
  warningSummary        Json?
  errorMessage          String?
  replyCount            Int      @default(0)
  lastReplyAt           DateTime?
  hasReplies            Boolean  @default(false)
  createdAt             DateTime @default(now())
  sentAt                DateTime?
  completedAt           DateTime?
  batch                 RecibosDispatchBatch @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items                 RecibosDispatchItem[]
  replies               RecibosDispatchReply[]
  resendOfRecipient     RecibosDispatchRecipient? @relation("RecipientResends", fields: [resendOfRecipientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resends               RecibosDispatchRecipient[] @relation("RecipientResends")

  @@index([batchId])
  @@index([status])
  @@index([providerMessageId])
  @@index([providerInternetMessageId])
  @@index([resolvedAt])
  @@index([resendOfRecipientId])
  @@map("recibos_dispatch_recipients")
}

model RecibosDispatchReply {
  id                       String   @id @default(cuid())
  officeId                 Int
  recipientId              String?
  provider                 String
  mailboxAddress           String
  providerMessageId        String
  providerThreadId         String?
  internetMessageId        String?
  inReplyTo                String?
  references               Json?
  trackingToken            String?
  senderName               String?
  senderEmail              String
  subject                  String
  textPreview              String
  bodyText                 String
  receivedAt               DateTime
  matchStatus              String
  matchMethod              String?
  candidateRecipientIds    Json?
  suggestedClassification  String?
  classificationRuleVersion String?
  confirmedClassification  String?
  classifiedByUserId       String?
  classifiedAt             DateTime?
  createdAt                DateTime @default(now())
  office                   Office   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipient                RecibosDispatchRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attachments              RecibosDispatchReplyAttachment[]

  @@unique([provider, mailboxAddress, providerMessageId])
  @@index([officeId, receivedAt])
  @@index([recipientId, receivedAt])
  @@index([matchStatus, receivedAt])
  @@index([providerThreadId])
  @@index([internetMessageId])
  @@map("recibos_dispatch_replies")
}

model RecibosDispatchReplyAttachment {
  id                   String   @id @default(cuid())
  replyId              String
  providerAttachmentId String?
  filename             String
  mimeType             String?
  byteSize             Int?
  contentId            String?
  isInline             Boolean  @default(false)
  createdAt            DateTime @default(now())
  reply                RecibosDispatchReply @relation(fields: [replyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([replyId])
  @@map("recibos_dispatch_reply_attachments")
}

model RecibosReplySyncCheckpoint {
  id                String   @id @default(cuid())
  officeId          Int
  provider          String
  mailboxAddress    String
  cursor            Json?
  graphDeltaLink    String?
  gmailUidValidity  String?
  gmailLastUid      Int?
  lastAttemptedAt   DateTime?
  lastSuccessfulAt  DateTime?
  lockedAt          DateTime?
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  office            Office   @relation(fields: [officeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([officeId, provider, mailboxAddress])
  @@index([officeId, updatedAt])
  @@map("recibos_reply_sync_checkpoints")
}

model RecibosProviderHealth {
  id                   String   @id @default(cuid())
  officeId             Int
  provider             String
  mailboxAddress       String
  status               String
  lastCheckedAt        DateTime?
  lastHealthyAt        DateTime?
  lastSuccessfulSendAt DateTime?
  lastSuccessfulSyncAt DateTime?
  lastError            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  office               Office   @relation(fields: [officeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([officeId, provider, mailboxAddress])
  @@index([officeId, updatedAt])
  @@map("recibos_provider_health")
}

model RecibosDispatchItem {
  id             String   @id @default(cuid())
  recipientId    String
  reciboId       String
  numeroRecibo   String
  rol            String
  monto          Float
  fechaEjecucion DateTime?
  createdAt      DateTime @default(now())
  recipient      RecibosDispatchRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([recipientId])
  @@index([reciboId])
  @@map("recibos_dispatch_items")
}

model Tribunal {
  id        String     @id @default(cuid())
  officeId  Int
  nombre    String
  direccion String?
  comuna    String?
  createdAt DateTime   @default(now())
  roles     RolCausa[]
  office    Office     @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model DiligenciaTipo {
  id          String       @id @default(cuid())
  officeId    Int
  nombre      String
  descripcion String?
  createdAt   DateTime     @default(now())
  diligencias Diligencia[]
  office      Office       @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model Estampo {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  activo     Boolean     @default(true)
  fileUrl    String
  nombre     String
  officeId   Int
  tipo       String
  contenido  String?
  documentos Documento[]
  office     Office      @relation("OfficeEstampos", fields: [officeId], references: [id])
  aranceles  Arancel[]   @relation("EstampoAranceles")
}

model EstampoBase {
  id              Int             @id @default(autoincrement())
  slug            String          @unique
  nombreVisible   String
  categoria       String
  descripcion     String?
  textoTemplate   String
  variablesSchema Json
  wizardSchema    Json
  version         Int             @default(1)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  documentos      Documento[]
  customs         EstampoCustom[]

  @@index([categoria, isActive])
  @@index([slug])
  @@map("estampo_bases")
}

model EstampoCustom {
  id                 Int         @id @default(autoincrement())
  baseId             Int
  officeId           Int
  nombreOverride     String?
  textoTemplate      String
  isDefaultForOffice Boolean     @default(true)
  isActive           Boolean     @default(true)
  version            Int         @default(1)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  base               EstampoBase @relation(fields: [baseId], references: [id], onDelete: Cascade)
  office             Office      @relation("OfficeEstampoCustoms", fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([baseId, officeId], name: "EstampoCustom_base_office_unique")
  @@index([officeId])
  @@index([baseId])
  @@index([officeId, isActive])
  @@map("estampo_customs")
}

enum EstadoRol {
  pendiente
  en_proceso
  terminado
  archivado
}

enum EstadoDiligencia {
  pendiente
  completada
  fallida
}

enum EstadoCobro {
  PAGADO
  NO_PAGADO
}

enum DocumentType {
  RECIBO
}
