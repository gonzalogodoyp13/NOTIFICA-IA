{
  "name": "notifica-ia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:utf8": "node scripts/check-utf8.mjs",
    "check:auth-audit": "node scripts/verify-auth-audit.mjs",
    "check:infrastructure": "ts-node --project scripts/tsconfig.json scripts/verify-infrastructure.ts --mode=static",
    "verify:infrastructure": "ts-node --project scripts/tsconfig.json scripts/verify-infrastructure.ts",
    "verify:reports:phase4": "ts-node --project scripts/tsconfig.json scripts/verify-report-phase4.ts",
    "verify:audit-retirement": "ts-node --project scripts/tsconfig.json scripts/verify-audit-retirement.ts",
    "test:phase6": "ts-node --project scripts/tsconfig.json scripts/verify-phase6-recibos.ts",
    "test:integration": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:qa": "ts-node --project scripts/tsconfig.json scripts/run-qa-tests.ts",
    "qa:auth": "playwright test --config=playwright.auth.config.ts --headed --project=chromium",
    "qa:auth:auto": "ts-node --project scripts/tsconfig.json scripts/qa-auth-state.ts",
    "db:seed:qa": "ts-node --project scripts/tsconfig.json scripts/qa-seed.ts seed",
    "db:seed:qa:reset": "ts-node --project scripts/tsconfig.json scripts/qa-seed.ts reset",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:backfill:recibos": "ts-node --compiler-options {\"module\":\"commonjs\"} scripts/backfill-recibo-linkage.ts",
    "db:backfill:auth-users": "ts-node --project scripts/tsconfig.json scripts/backfill-auth-user-ids.ts",
    "db:verify:workflow-indexes": "ts-node --project scripts/tsconfig.json scripts/verify-workflow-indexes.ts",
    "db:reconcile:reports": "ts-node --project scripts/tsconfig.json scripts/reconcile-report-history.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"commonjs\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@supabase/ssr": "^0.10.0",
    "@tanstack/react-query": "^5.90.7",
    "@types/mailparser": "^3.4.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "imapflow": "^1.4.2",
    "lucide-react": "^1.6.0",
    "mailparser": "^3.9.11",
    "next": "^14.2.33",
    "nodemailer": "^9.0.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.39",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.9"
  }
}
