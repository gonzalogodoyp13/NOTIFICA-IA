<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>0.12.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
    <AssemblyMetadata Include="PublisherSha256" Value="$(PublisherSha256)" />
    <EmbeddedResource Include="../release/SetupOperation.ps1" LogicalName="SetupOperation.ps1" />
    <EmbeddedResource Include="../release/ReleaseTools.psm1" LogicalName="ReleaseTools.psm1" />
  </ItemGroup>
</Project>
