model Documento {
  // Filled from RolCausa by a BEFORE INSERT trigger for existing writers.
  officeId            Int                @default(dbgenerated())
  id                  String             @id @default(cuid())
  rolId               String
  diligenciaId        String?
  notificacionId      String?
  estampoId           String?
  currentVersionId    String?
  nombre              String
  tipo                String
  pdfId               String?
  version             Int                @default(1)
  createdAt           DateTime           @default(now())
  textoEditado        String?
  estampoBaseId       Int?
  voidedAt            DateTime?
  voidReason          String?
  voidedByUserId      String?
  generatedByUserId   String?
  generatedAt         DateTime?
  sourceTemplate      Json?
  generationVariables Json?
  generationVersion   Int                @default(1)
  diligencia          Diligencia?        @relation(fields: [diligenciaId], references: [id])
  notificacion        Notificacion?      @relation(fields: [notificacionId], references: [id])
  estampoBase         EstampoBase?       @relation(fields: [estampoBaseId], references: [id])
  estampo             Estampo?           @relation(fields: [estampoId], references: [id])
  rol                 RolCausa           @relation(fields: [rolId, officeId], references: [id, officeId], onUpdate: Restrict)
  versions            DocumentoVersion[] @relation("DocumentoVersions")
  currentVersion      DocumentoVersion?  @relation("DocumentoCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([rolId, createdAt])
  @@unique([id, officeId])
  @@index([currentVersionId])
  @@index([notificacionId, tipo, voidedAt, createdAt])
  @@index([diligenciaId, tipo, voidedAt, createdAt])
}

model DocumentoVersion {
  // Filled from Documento by a BEFORE INSERT trigger for existing writers.
  officeId            Int         @default(dbgenerated())
