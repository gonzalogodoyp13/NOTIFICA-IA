  sourceSignatures    DocumentSignature[] @relation("SignatureSource")
  signedSignatures    DocumentSignature[] @relation("SignatureOutput")
  id                  String      @id @default(cuid())
  documentoId         String
  versionNumber       Int
  storageBucket       String
  storageKey          String
  fileName            String
  sizeBytes           Int
  checksumSha256      String
  mimeType            String
