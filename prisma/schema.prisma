  createdByUserId     String?
  deletedAt           DateTime?
  deletedByUserId     String?
  documento           Documento   @relation("DocumentoVersions", fields: [documentoId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  currentForDocuments Documento[] @relation("DocumentoCurrentVersion")
  recibos             Recibo[]

  @@unique([documentoId, versionNumber])
  @@unique([id, officeId, documentoId])
  @@index([documentoId, createdAt])
  @@index([storageBucket, storageKey])
}

