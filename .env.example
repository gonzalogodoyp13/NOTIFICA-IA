# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Canonical Supabase PostgreSQL connections. Copy both values from Supabase Connect.
# Runtime: shared Supavisor transaction mode (6543), one connection per warm instance.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=10&connect_timeout=10&sslmode=require
# Migrations/administration only: direct IPv6 or Supavisor session mode (5432).
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Application identity and public URLs
NEXT_PUBLIC_APP_NAME=NOTIFICA IA
NEXT_PUBLIC_APP_URL=
APP_URL=
NEXT_PUBLIC_BASE_URL=

# Local troubleshooting only. Keep false in production.
DEBUG_LOGS=false

# Allowed values: local, test, qa, preview, production.
NEXT_PUBLIC_ENVIRONMENT=local
QA_ALLOW_MUTATIONS=false

# Canonical activity outbox. Call POST /api/internal/activity-outbox/process every minute.
ACTIVITY_OUTBOX_SECRET=CHANGE_ME_TO_A_UNIQUE_RANDOM_SECRET

# Recibos send center. Defaults to dry-run if unset.
MAIL_PROVIDER=dry-run
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=NOTIFICA IA
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=

# Recibos reply tracking. Poll from an external scheduler every 15 minutes.
REPLY_SYNC_SECRET=CHANGE_ME_TO_A_UNIQUE_RANDOM_SECRET
REPLY_POLL_INTERVAL_MINUTES=15
REPLY_INITIAL_LOOKBACK_DAYS=7
MS_GRAPH_REPLY_ENABLED=false
GMAIL_REPLY_ENABLED=false
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_SECURE=true
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=

# Report automation and compatibility scheduler wrappers.
AUDIT_REPORT_SYNC_SECRET=CHANGE_ME_TO_A_UNIQUE_RANDOM_SECRET
REPORT_AUTOMATION_SECRET=CHANGE_ME_TO_A_UNIQUE_RANDOM_SECRET
AUDIT_FAILURE_EMAIL=
AUDIT_REPORT_ZIP_THRESHOLD_BYTES=10485760
